<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Necesario para poder inyectar IHttpClientFactory en esta capa -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <!-- Resiliencia para HttpClient (Retry, Circuit Breaker, Timeout...) construida sobre Polly v8 -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
  </ItemGroup>

</Project>
